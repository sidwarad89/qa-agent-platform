# Copy this file to .env and fill in as needed.
# Most API keys are provided by users at runtime through the UI, not stored here.
FERNET_SECRET_KEY=change-me-generate-a-real-key

# Powers the chatbot and the "tell me your goal" onboarding guide for ALL users -
# set this once as the admin so users never need their own key for these two features.
# Groq is recommended: genuinely free, no billing/KYC hassle.
PLATFORM_AI_PROVIDER=groq
PLATFORM_AI_API_KEY=your-groq-api-key-here
PLATFORM_AI_MODEL=llama-3.3-70b-versatile
